{{#*inline "body"}}
<section class="hero hero-compact">
    <p class="eyebrow">Search</p>
    <h1>{{title}}</h1>
    <p class="lead">{{description}}</p>
</section>

<section class="card search-card">
    <form
        class="search-form"
        action="/search"
        method="get"
        data-api-search
        data-results-target="#search-results"
    >
        <input
            class="search-field"
            type="text"
            name="query"
            value="{{query}}"
            placeholder="language:en topic:marketplace search text"
        >
        <input
            class="search-limit"
            type="number"
            name="limit"
            min="1"
            max="50"
            value="{{limit}}"
        >
        <button type="submit" class="btn">Search</button>
    </form>
</section>

<div id="search-results">
{{#if has_query}}
    {{#if has_results}}
    <section class="card">
        <div class="section-heading">
            <h2>Results</h2>
            <span class="muted">{{result_count}} matches</span>
        </div>
        <div class="search-results-grid">
            {{#each results}}
            <article class="search-result-card">
                <h3><a class="row-link" href="/pages/{{page_id}}">{{title}}</a></h3>
                <p><a href="{{url}}" target="_blank" rel="noopener noreferrer">{{url}}</a></p>
                <div class="meta-strip">
                    <span><strong>Host:</strong> {{host}}</span>
                    <span><strong>Language:</strong> {{language}}</span>
                    <span><strong>Last Scan:</strong> {{scraped_at}}</span>
                </div>
                {{#if site_category}}
                <div class="meta-badges">
                    <span class="site-category-badge site-confidence-{{site_category.confidence}}">{{site_category.label}} · {{site_category.confidence}}</span>
                </div>
                {{/if}}
            </article>
            {{/each}}
        </div>
    </section>
    {{else}}
    <section class="empty-state">
        <h2>No results</h2>
        <p>No indexed page or tagged site matched <strong>{{query}}</strong>.</p>
    </section>
    {{/if}}
    {{#if has_pagination}}
    <section class="pagination-bar">
        {{#if pagination.has_previous_page}}
        <a class="btn btn-secondary" href="{{pagination.previous_page_url}}">Previous</a>
        {{/if}}
        {{#if pagination.has_next_page}}
        <a class="btn btn-secondary" href="{{pagination.next_page_url}}">Next</a>
        {{/if}}
    </section>
    {{/if}}
{{else}}
<section class="empty-state">
    <h2>Search the dataset</h2>
    <p>Use the form above to search titles, URLs, emails, crypto, languages, topics, and keywords.</p>
    <h3>Advanced Search Syntax</h3>
    <p>Combine filters with AND logic:</p>
    <ul>
        <li><code>language:en</code> or <code>lang:en</code> - Filter by language</li>
        <li><code>topic:marketplace</code> - Filter by topic tag</li>
        <li><code>keyword:cisco</code> or <code>tag:cisco</code> - Filter by keyword tag</li>
        <li><code>language:en topic:forum search text</code> - Multiple filters with text search</li>
    </ul>
    <p>Examples:</p>
    <ul>
        <li><code>language:en</code> - All English pages</li>
        <li><code>topic:marketplace language:en</code> - English marketplace pages</li>
        <li><code>lang:ru topic:forum bitcoin</code> - Russian forum pages mentioning bitcoin</li>
    </ul>
</section>
{{/if}}
</div>
{{/inline}}

{{> base}}
